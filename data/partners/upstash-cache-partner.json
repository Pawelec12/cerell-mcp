  "tools": [
    {
      "name": "create_redis_database",
      "description": "Create a serverless Redis database cluster with REST API support",
      "params": [
        {
          "name": "database_name",
          "type": "string",
          "description": "Redis database name",
          "required": true
        },
        {
          "name": "region",
          "type": "string",
          "description": "Deployment region",
          "required": false,
          "default": "eu-central-1"
        }
      ],
      "returns": {
        "envVarTemplates": {
          "UPSTASH_REDIS_REST_URL": "https://{database_name}-{region}.upstash.io",
          "UPSTASH_REDIS_REST_TOKEN": "token_{database_name}_xyz"
        },
        "mockData": {
          "endpoint": "https://{database_name}-{region}.upstash.io",
          "port": 6379
        },
        "successMessage": "Upstash Redis database '{database_name}' provisioned successfully."
      }
    },
    {
      "name": "create_qstash_topic",
      "description": "Create a QStash publish/subscribe message queue topic",
      "params": [
        {
          "name": "topic_name",
          "type": "string",
          "description": "Topic name",
          "required": true
        }
      ],
      "returns": {
        "envVarTemplates": {
          "QSTASH_TOKEN": "qstash_token_{topic_name}"
        },
        "mockData": { "topic": "{topic_name}", "subscribers": 0 },
        "successMessage": "QStash topic '{topic_name}' created."
      }
    }
  ],
