{
  "name": "@cerell/mcp",
  "version": "0.2.1",
  "description": "Cerell MCP server — provision, monitor, and earn cashback on your infrastructure stack from AI code editors",
  "type": "module",
  "bin": {
    "cerell": "bin/cerell.js",
    "cerell-mcp": "bin/cerell.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "data/partners",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/server.test.mjs",
    "test:workflow": "npm run build && node test-workflow.mjs",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "cerell",
    "claude",
    "cursor",
    "developer-tools",
    "cashback",
    "cloud",
    "infrastructure"
  ],
  "author": "Pawelec12",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pawelec12/cerell-mcp.git"
  },
  "homepage": "https://cerell.eu"
}
